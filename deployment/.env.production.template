# ==============================================================================
# Production Environment Variables Template
# Copy this file and fill in the values for production deployment
# ==============================================================================

# ==========================================================================
# Django Backend
# ==========================================================================

# Security - Generate with either:
# - Django (if installed): python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# - Standard library only: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
# - Or use an online Django SECRET_KEY generator.
SECRET_KEY=your-super-secret-production-key-here

# Debug mode - MUST be False in production
DEBUG=False

# Allowed hosts - Comma separated list
ALLOWED_HOSTS=zorven.ai,www.zorven.ai,api.zorven.ai,*.run.app

# Database - Neon PostgreSQL (PRODUCTION branch)
# Dev branch uses ep-delicate-unit-* pooler; prod uses ep-lively-sun-* pooler
DATABASE_URL=postgresql://neondb_owner:<password>@ep-lively-sun-aek04lw0-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ==========================================================================
# Redis / Celery
# ==========================================================================

# Redis URL - Memorystore private IP, reached via the VPC connector
REDIS_URL=redis://default:password@host:6379

# Celery configuration
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ==========================================================================
# AI Services
# ==========================================================================

# Google Gemini API Key
GOOGLE_API_KEY=your-gemini-api-key

# Tavily API Key (web research for discovery agent)
TAVILY_API_KEY=your-tavily-api-key

# ==========================================================================
# Stripe Payments
# ==========================================================================

# Stripe API Keys
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs
STRIPE_PRICE_BASIC=price_basic_plan_id
STRIPE_PRICE_PRO=price_pro_plan_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_plan_id

# ==========================================================================
# CORS Settings
# ==========================================================================

# Allowed origins for CORS - Frontend URL
CORS_ALLOWED_ORIGINS=https://zorven.ai,https://www.zorven.ai

# ==========================================================================
# Optional: Social OAuth (for automation features)
# ==========================================================================

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Twitter/X OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Facebook/Instagram OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ==========================================================================
# Optional: Monitoring & Logging
# ==========================================================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Log level
LOG_LEVEL=info

# ==========================================================================
# Gunicorn Configuration
# ==========================================================================

# Number of worker processes
GUNICORN_WORKERS=4

# Number of threads per worker
GUNICORN_THREADS=2

# ==========================================================================
# Frontend Environment Variables
# ==========================================================================

# ==========================================================================
# Multi-tenancy: default GCS buckets
# Tenants can override via the Tenant model; these are fallback defaults.
# ==========================================================================
GCS_RAW_BUCKET=zorven-raw-assets
GCS_CURATED_BUCKET=zorven-curated-assets

# Auto-provision GCS buckets when a new tenant is created.
# Set to true in production; false in dev/test to avoid GCS API calls.
GCS_AUTO_PROVISION=false

# GCP project ID used for bucket provisioning
GCP_PROJECT_ID=zorven-503517

# API URL for the frontend to communicate with backend
NEXT_PUBLIC_API_URL=https://api.zorven.ai
