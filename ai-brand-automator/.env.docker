# Docker Compose Environment Variables
# Copy this file to .env and customize values

# =============================================================================
# Django Settings
# =============================================================================
SECRET_KEY=your-super-secret-key-for-jwt-signing-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,kong

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_NAME=brand_automator
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# =============================================================================
# Kong Gateway Settings
# =============================================================================
KONG_ENABLED=True
JWT_ISSUER=ai-brand-automator
KONG_HANDLES_CORS=True

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Kafka Settings
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=brand-automator-consumers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=True

# =============================================================================
# Celery Settings
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# External Services (Optional)
# =============================================================================
# Google AI
GOOGLE_API_KEY=

# GCS (Google Cloud Storage)
GS_BUCKET_NAME=
GS_PROJECT_ID=
GCS_CREDENTIALS_PATH=

# GCP Access Token (for Kong GCS uploads)
GCP_ACCESS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Social Platform OAuth (Optional - for automation)
# =============================================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
