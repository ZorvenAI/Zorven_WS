# Prevent local environment files from entering Docker image
# Cloud Run injects env vars via os.environ, not .env files
.env
.env.*
.env.local
.env.*.local
.env.docker
.env.docker.local
.env.example
.env.test

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
htmlcov/

# Development artifacts
db.sqlite3
media/
logs/
*.log
.coverage
coverage.xml

# IDE
.vscode/
.idea/

# Git
.git/
.github/
