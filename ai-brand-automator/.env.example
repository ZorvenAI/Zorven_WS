# Django Configuration
# Generate a new SECRET_KEY by running: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Option 1: Use DATABASE_URL (not currently used but available)
# DATABASE_URL=postgresql://your-db-user:your-db-password@your-host.neon.tech/your-database?sslmode=require&channel_binding=require

# Option 2: Use individual settings (currently active)
DB_NAME=your-database-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-host.neon.tech
DB_PORT=5432
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External Services
GOOGLE_API_KEY=your-google-api-key
GS_BUCKET_NAME=your-gcs-bucket-name
GS_PROJECT_ID=your-gcp-project-id
GS_CREDENTIALS_PATH=path/to/service-account.json

# Multi-tenancy: default GCS buckets (tenants can override via Tenant model)
GCS_RAW_BUCKET=onboarding-bucket1
GCS_CURATED_BUCKET=brandsol-curation-bucket

# Payment Services (to be added later)
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Kong Gateway Configuration
# Set to True when running behind Kong Gateway (production/docker)
KONG_ENABLED=False
# JWT issuer claim for Kong validation (must match kong.yaml consumer key)
JWT_ISSUER=ai-brand-automator

# Kafka Configuration
# Required when using Kong with Kafka logging or event streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=brand-automator-consumers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=True
KAFKA_SESSION_TIMEOUT_MS=30000

# GCS Direct Upload (Kong-managed)
# GCS_RESUMABLE_UPLOAD_ENABLED=True
# GCS_SIGNED_URL_EXPIRATION=3600

# =============================================================================
# Data Ingestion Service Configuration
# =============================================================================

# GCP Configuration
GCP_PROJECT_ID=brandsol
GCP_BUCKET_NAME=onboarding-bucket1
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcs-credentials.json

# Kafka Topics for Ingestion Pipeline
INGESTION_KAFKA_INPUT_TOPIC=raw-ingestion-topic
INGESTION_KAFKA_OUTPUT_TOPIC=curation-needed-topic
INGESTION_KAFKA_DLQ_TOPIC=ingestion-dlq
INGESTION_KAFKA_GROUP_ID=ingestion-svc-group

# Processing Configuration
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BACKOFF=1.0
INGESTION_DEDUPE_TTL=3600
INGESTION_STATUS_TTL=604800
