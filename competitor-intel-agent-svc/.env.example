# === Competitor Intelligence Agent Configuration ===
# All settings use CIA_ prefix

# Redis (DB 12)
CIA_REDIS_URL=redis://localhost:6379/12

# Kafka (empty = disabled)
CIA_KAFKA_BOOTSTRAP_SERVERS=
CIA_KAFKA_CONSUMERS_ENABLED=false

# LLM - Claude Sonnet 4
CIA_ANTHROPIC_API_KEY=
CIA_LLM_MODEL=claude-sonnet-4-5-20250929
CIA_LLM_TEMPERATURE=0.3
CIA_LLM_MAX_TOKENS=4096

# Data sources
CIA_TAVILY_API_KEY=

# Server
CIA_HOST=0.0.0.0
CIA_PORT=8022

# Guardrails
CIA_RATE_LIMIT_PER_MINUTE=10
CIA_CONFIDENCE_THRESHOLD=0.7
CIA_TOKEN_BUDGET_PER_SESSION=75000
CIA_MAX_COMPETITORS=20
CIA_MAX_PAGES_PER_DOMAIN=5
CIA_OUTPUT_MAX_CHARS=150000

# RBAC
CIA_RBAC_ENABLED=true

# RAG + GCS (disabled by default)
CIA_RAG_ENABLED=false
CIA_RAG_SERVICE_URL=http://localhost:8070
CIA_GCS_ENABLED=false
CIA_GCS_CREDENTIALS_JSON=

# Service auth
CIA_SERVICE_TOKEN=dev-service-token
