# Brand Positioning Agent — Environment Variables
# All use BPA_ prefix

# Server
BPA_PORT=8031
BPA_LOG_LEVEL=INFO

# Redis (DB 16)
BPA_REDIS_URL=redis://localhost:6379/16

# Anthropic Claude Sonnet 4
BPA_ANTHROPIC_API_KEY=sk-ant-xxx
BPA_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
BPA_ANTHROPIC_MAX_TOKENS=8192
BPA_ANTHROPIC_TEMPERATURE=0.4

# Tavily (competitive research)
BPA_TAVILY_API_KEY=tvly-xxx

# Service auth
BPA_SERVICE_TOKEN=dev-service-token

# Django backend (WF1 context)
BPA_BACKEND_URL=http://localhost:8001
BPA_BACKEND_SERVICE_TOKEN=dev-service-token

# Kafka (optional)
BPA_KAFKA_BOOTSTRAP_SERVERS=
BPA_KAFKA_CONSUMERS_ENABLED=false

# GCS (strategy persistence)
BPA_GCS_BUCKET_PREFIX=
BPA_GCS_CREDENTIALS_JSON=

# Vertex AI RAG
BPA_VERTEX_PROJECT_ID=
BPA_VERTEX_LOCATION=us-central1
BPA_RAG_SERVICE_URL=

# Positioning config
BPA_DEFAULT_CANDIDATE_COUNT=3
BPA_MAX_CANDIDATE_COUNT=7
BPA_DEFAULT_PERCEPTUAL_MAPS=3
BPA_MAX_PERCEPTUAL_MAPS=5

# CORS
BPA_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
