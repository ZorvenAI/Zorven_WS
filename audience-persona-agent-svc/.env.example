# Audience Persona Agent — Environment Variables
# All settings use the APA_ prefix

# Auth
APA_SERVICE_TOKEN=dev-service-token

# Redis (DB 13)
APA_REDIS_URL=redis://localhost:6379/13

# Kafka (optional)
APA_KAFKA_BOOTSTRAP_SERVERS=
APA_KAFKA_CONSUMERS_ENABLED=false

# LLM — Claude Sonnet 4
APA_ANTHROPIC_API_KEY=
APA_LLM_MODEL=claude-sonnet-4-5-20250929
APA_LLM_TEMPERATURE=0.3
APA_LLM_MAX_TOKENS=4096

# Data sources
APA_TAVILY_API_KEY=

# Odoo integration (feature-flagged, disabled by default)
APA_ODOO_ENABLED=false
APA_ODOO_URL=
APA_ODOO_DB=
APA_ODOO_USERNAME=
APA_ODOO_PASSWORD=

# RAG service
APA_RAG_SERVICE_URL=

# GCS (for report persistence)
APA_GCS_CREDENTIALS_JSON=
APA_GCS_BUCKET=

# Server
APA_HOST=0.0.0.0
APA_PORT=8023
APA_LOG_LEVEL=INFO
APA_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Guardrails
APA_RATE_LIMIT_PER_MINUTE=10
APA_MAX_PERSONAS=5
APA_TOKEN_BUDGET_PER_SESSION=80000
