# =============================================================================
# Odoo MCP Server — Environment Variables
# All prefixed with ODOO_MCP_ (loaded via Pydantic BaseSettings)
# =============================================================================

# --- Odoo Connection ---
ODOO_MCP_ODOO_URL=http://localhost:8069
ODOO_MCP_ODOO_MASTER_PASSWORD=admin

# --- Redis (DB 9) ---
ODOO_MCP_REDIS_URL=redis://localhost:6379/9

# --- MCP Transport ---
ODOO_MCP_MCP_TRANSPORT=streamable-http

# --- Multi-Tenancy ---
# Options: dedicated_db | shared_instance | shared_db
ODOO_MCP_TENANT_MODEL=shared_instance

# --- RBAC ---
# Options: enforcing | permissive | disabled
ODOO_MCP_RBAC_ENFORCEMENT=permissive
ODOO_MCP_RBAC_ROLES_DIR=config/roles

# --- RAG Integration ---
ODOO_MCP_RAG_SERVICE_URL=http://localhost:8070
ODOO_MCP_RAG_ENABLED=false

# --- Kafka (leave empty to disable) ---
ODOO_MCP_KAFKA_BOOTSTRAP_SERVERS=

# --- Service Authentication ---
ODOO_MCP_SERVICE_TOKEN=dev-service-token

# --- Server ---
ODOO_MCP_PORT=8095
PORT=8095
