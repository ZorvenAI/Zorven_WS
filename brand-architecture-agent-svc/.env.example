# Brand Architecture Agent — Environment Variables
# All use BAA_ prefix

# Server
BAA_PORT=8032
BAA_LOG_LEVEL=INFO

# Redis (DB 17)
BAA_REDIS_URL=redis://localhost:6379/17

# Anthropic Claude Sonnet 4
BAA_ANTHROPIC_API_KEY=sk-ant-xxx
BAA_ANTHROPIC_MODEL=claude-sonnet-4-20250514
BAA_ANTHROPIC_MAX_TOKENS=8192
BAA_ANTHROPIC_TEMPERATURE=0.4

# Tavily (supplementary research)
BAA_TAVILY_API_KEY=tvly-xxx

# Service auth
BAA_SERVICE_TOKEN=dev-service-token

# Django backend (WF1 + BPA + Company context)
BAA_BACKEND_URL=http://localhost:8001
BAA_BACKEND_SERVICE_TOKEN=dev-service-token

# Kafka (optional)
BAA_KAFKA_BOOTSTRAP_SERVERS=
BAA_KAFKA_CONSUMERS_ENABLED=false

# GCS (strategy persistence)
BAA_GCS_BUCKET_PREFIX=
BAA_GCS_CREDENTIALS_JSON=

# Vertex AI RAG
BAA_VERTEX_PROJECT_ID=
BAA_VERTEX_LOCATION=us-central1
BAA_RAG_SERVICE_URL=

# Architecture config
BAA_MAX_SUB_BRAND_COUNT=15
BAA_MAX_HIERARCHY_DEPTH=4
BAA_CONFIDENCE_THRESHOLD=0.7

# CORS
BAA_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
