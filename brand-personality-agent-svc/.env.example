# Brand Personality & Values Agent — Environment Variables
# All use BPV_ prefix

# Server
BPV_PORT=8033
BPV_LOG_LEVEL=INFO

# Redis (DB 18)
BPV_REDIS_URL=redis://localhost:6379/18

# Anthropic Claude Sonnet 4
BPV_ANTHROPIC_API_KEY=sk-ant-xxx
BPV_ANTHROPIC_MODEL=claude-sonnet-4-20250514
BPV_ANTHROPIC_MAX_TOKENS=8192
BPV_ANTHROPIC_TEMPERATURE=0.4

# Service auth
BPV_SERVICE_TOKEN=dev-service-token

# Django backend (WF1 + BPA + Company context)
BPV_BACKEND_URL=http://localhost:8001
BPV_BACKEND_SERVICE_TOKEN=dev-service-token

# Kafka (optional)
BPV_KAFKA_BOOTSTRAP_SERVERS=
BPV_KAFKA_CONSUMERS_ENABLED=false

# GCS (personality persistence — deferred to v2)
BPV_GCS_BUCKET_PREFIX=
BPV_GCS_CREDENTIALS_JSON=

# Vertex AI RAG
BPV_VERTEX_PROJECT_ID=
BPV_VERTEX_LOCATION=us-central1
BPV_RAG_SERVICE_URL=

# Personality config
BPV_MAX_CORE_VALUES=5
BPV_MAX_SUPPORTING_VALUES=5
BPV_MAX_ASPIRATIONAL_VALUES=3
BPV_CONFIDENCE_THRESHOLD=0.7

# CORS
BPV_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
